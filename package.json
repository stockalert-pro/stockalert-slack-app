{
  "name": "@stockalert/slack-app",
  "version": "1.0.3",
  "description": "Slack app for receiving StockAlert.pro webhook notifications",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "start:vercel": "vercel dev",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:webhook": "tsx scripts/test-webhook.ts",
    "test:performance": "tsx scripts/performance-test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "stockalert",
    "slack",
    "webhooks",
    "stock-market",
    "notifications"
  ],
  "author": "StockAlert.pro",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@slack/web-api": "^7.13.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/node": "^5.5.28",
    "@vercel/postgres": "^0.10.0",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/node-fetch": "^2.6.0",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
